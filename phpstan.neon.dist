includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # The config file of the package is not in the config directory of the app
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/filament-oauth2.php
